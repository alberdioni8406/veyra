# Required
SECRET_KEY=generate-a-long-random-string-with-openssl-rand-hex-32
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Bitcoin Cash
BCH_RECEIVING_ADDRESS=bitcoincash:your-address-here
PAYMENT_TEST_MODE=false
BCH_MIN_CONFIRMATIONS=1

# Platform economics
PLATFORM_ROOM_FEE_PERCENT=10
PLATFORM_ENTRY_FEE_PERCENT=5
MINIMUM_ROOM_PRICE=0.0001
BASE_RENTAL_PER_HOUR=0.001

# Optional – only for local SQLite testing
# DATABASE_URL=sqlite:////tmp/veyra.db
# PAYMENT_TEST_MODE=true
